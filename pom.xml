<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.eduardo.dbeaver.aichat</groupId>
  <artifactId>aichat-parent</artifactId>
  <version>0.1.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <tycho.version>4.0.10</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <aichat.resolveEE>JavaSE-17</aichat.resolveEE>
  </properties>

  <modules>
    <module>core</module>
    <module>bundles/io.github.eduardo.dbeaver.aichat</module>
    <module>features/io.github.eduardo.dbeaver.aichat.feature</module>
    <module>releng/update-site</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-compiler-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Java 17 bytecode even when the build runs on JDK 21 (DBeaver 24.1 ships JRE 17). -->
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <file>${maven.multiModuleProjectDirectory}/releng/target/dbeaver.target</file>
          </target>
          <pomDependencies>ignore</pomDependencies>
          <!-- Newer DBeaver releases ship Eclipse bundles that require JavaSE-21. scripts/verify.sh latest
               resolves with -Daichat.resolveEE=JavaSE-21 on a JDK 21; the compiler still emits Java 17 bytecode. -->
          <executionEnvironment>${aichat.resolveEE}</executionEnvironment>
          <environments>
            <environment>
              <os>linux</os>
              <ws>gtk</ws>
              <arch>x86_64</arch>
            </environment>
          </environments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
